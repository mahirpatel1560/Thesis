# Copy to .env and fill in. .env is gitignored and excluded from the Docker
# image; this file carries the names only, never the values.

# Discord bot token — Developer Portal > your app > Bot > Reset Token.
DISCORD_TOKEN=

# Anthropic API key. Optional locally if you are logged in via `ant auth login`;
# required in the container, which has no interactive session to borrow from.
ANTHROPIC_API_KEY=

# SEC requires a descriptive User-Agent with contact info on every EDGAR request.
# Filings are refused without it, which means /research fails on a cache miss.
SEC_EDGAR_USER_AGENT=thesis-league you@example.com

# Model for your own `thesis research` briefs. League cycles and /research ignore
# this and run on claude-sonnet-5 (config.LEAGUE_MODEL) — a league fans out one
# call per member, so the cheaper model is the right trade there.
THESIS_MODEL=claude-opus-4-8

# --- optional: where state lives -------------------------------------------
# Defaults put everything under ./.cache and ./briefs. docker-compose.yml sets
# these to /data/... so the volume holds them; you rarely set them by hand.
# THESIS_CACHE_DIR=
# THESIS_BRIEFS_DIR=
# THESIS_REPORTS_DIR=
