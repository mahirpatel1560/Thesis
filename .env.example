# Copy to .env and fill in. .env is gitignored — never commit it.

# Claude API key (https://platform.claude.com). Optional if you're logged in via `ant auth login`.
ANTHROPIC_API_KEY=

# Model used for brief generation
THESIS_MODEL=claude-opus-4-8

# SEC EDGAR requires a descriptive User-Agent with a contact email
SEC_EDGAR_USER_AGENT=thesis-cli your.email@example.com

# Discord bot token for the league (`thesis bot`). Leave blank if you don't run it.
# League cycles run on claude-sonnet-5, not the model above.
DISCORD_TOKEN=
